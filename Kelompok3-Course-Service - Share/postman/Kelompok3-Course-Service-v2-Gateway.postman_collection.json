{"info":{"_postman_id":"kelompok3-course-service-v2-gateway-registry","description":"Kelompok 3 Course Service, disesuaikan dengan Gateway Registry Kelompok 1 (gateway 127.0.0.1:8101, resolver.php + services.json, nama logis course). Uji registry persis seperti di laporan Kelompok 1, lalu uji course di alamat resolved_url.","name":"Kelompok 3 - Course Service v2 (Gateway Registry Kelompok 1)","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"item":[{"name":"1. Registry - nama valid (course)","request":{"header":[],"method":"GET","url":{"host":["{{gatewayUrl}}"],"path":["api","registry","course"],"raw":"{{gatewayUrl}}/api/registry/course"}}},{"name":"2. Registry - nama tidak ditemukan (sinta)","request":{"header":[],"method":"GET","url":{"host":["{{gatewayUrl}}"],"path":["api","registry","sinta"],"raw":"{{gatewayUrl}}/api/registry/sinta"}}},{"name":"3. Registry - service mati (STOP dulu course di 8103, lalu kirim)","request":{"header":[],"method":"GET","url":{"host":["{{gatewayUrl}}"],"path":["api","registry","course"],"raw":"{{gatewayUrl}}/api/registry/course"}}},{"name":"4. Registry - setelah ubah port ke 8203 (course jalan di 8203, services.json diubah Kelompok 1)","request":{"header":[],"method":"GET","url":{"host":["{{gatewayUrl}}"],"path":["api","registry","course"],"raw":"{{gatewayUrl}}/api/registry/course"}}}],"name":"Tahap Registry - Gateway Kelompok 1 (8101)"},{"item":[{"name":"1. GET semua course di resolved_url","request":{"header":[],"method":"GET","url":{"host":["{{courseUrl}}"],"path":["api","courses"],"raw":"{{courseUrl}}/api/courses"}}},{"name":"2. POST tambah course","request":{"body":{"mode":"raw","options":{"raw":{"language":"json"}},"raw":"{\n  \"code\": \"PTIK303\",\n  \"name\": \"Basis Data\",\n  \"credits\": 3\n}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":{"host":["{{courseUrl}}"],"path":["api","courses"],"raw":"{{courseUrl}}/api/courses"}}},{"name":"3. GET detail course id 1","request":{"header":[],"method":"GET","url":{"host":["{{courseUrl}}"],"path":["api","courses","1"],"raw":"{{courseUrl}}/api/courses/1"}}},{"name":"4. GET health (untuk Kelompok 7 Monitoring)","request":{"header":[],"method":"GET","url":{"host":["{{courseUrl}}"],"path":["api","health"],"raw":"{{courseUrl}}/api/health"}}},{"name":"5. DELETE course id 3 (data uji dari POST)","request":{"header":[],"method":"DELETE","url":{"host":["{{courseUrl}}"],"path":["api","courses","3"],"raw":"{{courseUrl}}/api/courses/3"}}}],"name":"Tahap Course - di alamat resolved_url (8103)"},{"item":[{"name":"1. GET semua course via XAMPP Apache","request":{"header":[],"method":"GET","url":{"host":["{{xamppUrl}}"],"path":["api","courses"],"raw":"{{xamppUrl}}/api/courses"}}},{"name":"2. GET health via XAMPP Apache","request":{"header":[],"method":"GET","url":{"host":["{{xamppUrl}}"],"path":["api","health"],"raw":"{{xamppUrl}}/api/health"}}}],"name":"Tahap Mandiri - XAMPP Apache (cadangan, tanpa Gateway)"}],"variable":[{"key":"gatewayUrl","value":"http://10.194.169.115:4001"},{"key":"courseUrl","value":"http://10.194.169.115:8103"},{"key":"xamppUrl","value":"http://10.194.169.115/Kelompok3-Course-Service"}]}